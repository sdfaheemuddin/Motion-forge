{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      },
      "minItems": 0
    },
    "layout": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "composition": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "camera": {
      "type": "object",
      "properties": {
        "focus": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "transition": {
          "type": "number",
          "minimum": 0
        },
        "fit": {
          "enum": [
            "fill",
            "contain"
          ]
        },
        "easing": {
          "enum": [
            "linear",
            "easeIn",
            "easeOut",
            "easeInOut"
          ]
        }
      },
      "additionalProperties": false
    },
    "activeNavigationItem": {
      "type": "string"
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false,
  "$defs": {
    "element": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "number"
        },
        "visibility": {
          "type": "object",
          "properties": {
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "transform": {
          "type": "object",
          "properties": {
            "position": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "anchor": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "scale": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "rotation": {
              "type": "number"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "color": {
                "type": "string",
                "minLength": 1
              },
              "radius": {
                "type": "number",
                "minimum": 0
              },
              "intensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "offset": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "samples": {
                "type": "integer",
                "minimum": 2,
                "maximum": 64
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "text": {
          "type": "string"
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "lineSpacing": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fit": {
          "enum": [
            "contain",
            "cover",
            "stretch"
          ]
        },
        "shape": {
          "enum": [
            "circle",
            "rectangle",
            "ellipse"
          ]
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cornerRadius": {
          "type": "number",
          "minimum": 0
        },
        "fill": {
          "type": "string",
          "minLength": 1
        },
        "stroke": {
          "type": "string",
          "minLength": 1
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 2
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 2
          },
          "minItems": 1
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trimStart": {
          "type": "number",
          "minimum": 0
        },
        "playbackSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          },
          "minItems": 1
        },
        "parameters": {
          "type": "object"
        },
        "binding": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "required": [
        "layout",
        "composition"
      ],
      "properties": {
        "elements": {
          "maxItems": 0
        }
      }
    },
    {
      "required": [
        "elements"
      ],
      "not": {
        "required": [
          "layout"
        ]
      },
      "properties": {
        "elements": {
          "minItems": 1
        }
      }
    }
  ]
}
