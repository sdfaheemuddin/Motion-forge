{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "type": {
            "enum": [
              "image",
              "font",
              "video",
              "audio",
              "path"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "type",
          "source"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "assets"
  ],
  "additionalProperties": false
}
